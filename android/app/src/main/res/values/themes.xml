<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme; values-night/themes.xml swaps in the dark one when the system is in dark mode -->
    <style name="AppTheme" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:buttonStyle">@style/Widget.App.Button</item>
    </style>

    <style name="Widget.App.Button" parent="android:Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/btn_rounded</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>

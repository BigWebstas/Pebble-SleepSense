<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/sky_primary_light</item>
        <item name="colorOnPrimary">@color/sky_on_primary_light</item>
        <item name="colorPrimaryContainer">@color/sky_primary_container_light</item>
        <item name="colorOnPrimaryContainer">@color/sky_on_primary_container_light</item>
        <item name="colorSecondary">@color/sky_secondary_light</item>
        <item name="colorOnSecondary">@color/sky_on_secondary_light</item>
        <item name="colorSecondaryContainer">@color/sky_secondary_container_light</item>
        <item name="colorOnSecondaryContainer">@color/sky_on_secondary_container_light</item>
        <item name="colorTertiary">@color/sky_tertiary_light</item>
        <item name="colorSurface">@color/sky_background_light</item>
        <item name="colorOnSurface">@color/sky_on_surface_light</item>
        <item name="colorSurfaceContainer">@color/sky_card_light</item>
        <item name="colorSurfaceContainerHigh">@color/sky_card_high_light</item>
        <item name="colorSurfaceVariant">@color/sky_surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/sky_on_surface_variant_light</item>
        <item name="colorOutline">@color/sky_outline_light</item>
        <item name="colorOutlineVariant">@color/sky_outline_variant_light</item>
        <item name="android:colorBackground">@color/sky_background_light</item>
    </style>

    <style name="SectionHeader" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">?attr/colorSecondary</item>
    </style>

    <style name="SectionCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Applied over the dark theme for OLED screens -->
    <style name="TrueBlack">
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainer">#0B111C</item>
        <item name="colorSurfaceContainerHigh">#131B2A</item>
    </style>
</resources>

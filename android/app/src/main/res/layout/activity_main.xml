<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/main_status_text" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tracking_section_label"
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tracking_section" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/tracking_dot_start"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/ic_tracking_dot"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tracking_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:gravity="center"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/tracking_dot_end"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/ic_tracking_dot"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/alarm_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center" />

        <Button
            android:id="@+id/tracking_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minWidth="220dp"
            app:icon="@drawable/ic_play_arrow"
            app:iconPadding="8dp"
            android:text="@string/start_tracking_button" />

        <Button
            android:id="@+id/clock_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="220dp"
            app:icon="@drawable/ic_alarm"
            app:iconPadding="8dp"
            android:text="@string/open_clock_button" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp" />

        <TextView
            android:id="@+id/alarm_section_label"
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/alarm_section" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/alarm_sync_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/alarm_sync_label" />

        <Button
            android:id="@+id/alarm_time_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="220dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/alarm_enabled_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/alarm_enabled_label" />

        <Button
            android:id="@+id/snooze_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="220dp" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp" />

        <TextView
            android:id="@+id/review_section_label"
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/review_section" />

        <Button
            android:id="@+id/clips_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="220dp"
            app:icon="@drawable/ic_mic"
            app:iconPadding="8dp"
            android:text="@string/noise_clips_button" />

        <Button
            android:id="@+id/history_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="220dp"
            app:icon="@drawable/ic_history"
            app:iconPadding="8dp"
            android:text="@string/history_button" />

        <Button
            android:id="@+id/advanced_toggle_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:minWidth="220dp"
            app:icon="@drawable/ic_expand_more"
            app:iconPadding="8dp"
            android:text="@string/show_advanced_button" />

        <LinearLayout
            android:id="@+id/advanced_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Thicker and in the accent colour, so it shows where the basic settings end -->
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:dividerColor="?attr/colorPrimary"
                app:dividerThickness="3dp" />

            <TextView
                android:id="@+id/noise_clips_section_label"
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/noise_clips_section" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/noise_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/noise_label" />

            <TextView
                android:id="@+id/noise_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textSize="13sp" />

            <Button
                android:id="@+id/noise_sensitivity_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_tune"
                app:iconPadding="8dp" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/oximeter_section_label"
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/oximeter_section" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/oximeter_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/oximeter_label" />

            <TextView
                android:id="@+id/oximeter_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textSize="13sp" />

            <Button
                android:id="@+id/oximeter_choose_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="220dp"
                android:text="@string/oximeter_choose_button" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/bedtime_section_label"
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/bedtime_section" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/bedtime_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/bedtime_label" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/white_noise_section_label"
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/white_noise_section" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/white_noise_tracking_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/white_noise_tracking_label" />

            <Button
                android:id="@+id/white_noise_sound_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_graphic_eq"
                app:iconPadding="8dp"
                android:text="@string/white_noise_sound_label" />

            <Button
                android:id="@+id/white_noise_play_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconPadding="8dp"
                android:text="@string/white_noise_play_button" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/connectivity_label"
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/connectivity_label" />

            <Button
                android:id="@+id/home_assistant_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_home"
                app:iconPadding="8dp"
                android:text="@string/home_assistant_button" />

            <TextView
                android:id="@+id/home_assistant_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textSize="13sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/calendar_sync_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/calendar_sync_label" />

            <Button
                android:id="@+id/calendar_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_history"
                app:iconPadding="8dp"
                android:text="@string/calendar_choose_button" />

            <Button
                android:id="@+id/grant_hc_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_favorite"
                app:iconPadding="8dp"
                android:text="@string/grant_hc_button" />

            <TextView
                android:id="@+id/hc_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/interfacing_label"
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/interfacing_label" />

            <Button
                android:id="@+id/widget_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_widgets"
                app:iconPadding="8dp"
                android:text="@string/add_widget_button" />

            <Button
                android:id="@+id/install_watch_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_watch"
                app:iconPadding="8dp"
                android:text="@string/install_watch_button" />

            <Button
                android:id="@+id/update_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_system_update"
                app:iconPadding="8dp"
                android:text="@string/check_update_button" />

            <TextView
                android:id="@+id/update_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/chest_section_label"
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/chest_section" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chest_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/chest_label" />

            <TextView
                android:id="@+id/chest_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textSize="13sp" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/live_section_label"
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/live_section" />

            <TextView
                android:id="@+id/live_readings_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp" />

            <net.webstas.sleepsense.WaveformView
                android:id="@+id/live_waveform"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/live_waveform"
                android:visibility="gone" />

            <net.webstas.sleepsense.ChestRateView
                android:id="@+id/chest_rate_view"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/chest_rate_graph"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/version_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:alpha="0.6"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>

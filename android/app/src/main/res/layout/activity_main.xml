<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/main_status_text" />

        <TextView
            android:id="@+id/tracking_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarm_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center" />

        <Button
            android:id="@+id/tracking_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minWidth="220dp"
            app:icon="@drawable/ic_play_arrow"
            app:iconPadding="8dp"
            android:text="@string/start_tracking_button" />

        <Button
            android:id="@+id/clock_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="220dp"
            app:icon="@drawable/ic_alarm"
            app:iconPadding="8dp"
            android:text="@string/open_clock_button" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/alarm_sync_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/alarm_sync_label" />

        <Button
            android:id="@+id/alarm_time_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="220dp" />

        <Button
            android:id="@+id/snooze_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="220dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/noise_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/noise_label" />

        <TextView
            android:id="@+id/noise_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textSize="13sp" />

        <Button
            android:id="@+id/noise_sensitivity_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="220dp"
            app:icon="@drawable/ic_tune"
            app:iconPadding="8dp" />

        <Button
            android:id="@+id/clips_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="220dp"
            app:icon="@drawable/ic_mic"
            app:iconPadding="8dp"
            android:text="@string/noise_clips_button" />

        <Button
            android:id="@+id/history_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="220dp"
            app:icon="@drawable/ic_history"
            app:iconPadding="8dp"
            android:text="@string/history_button" />

        <Button
            android:id="@+id/advanced_toggle_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="220dp"
            app:icon="@drawable/ic_expand_more"
            app:iconPadding="8dp"
            android:text="@string/show_advanced_button" />

        <LinearLayout
            android:id="@+id/advanced_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/white_noise_section"
                android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/white_noise_tracking_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/white_noise_tracking_label" />

            <Button
                android:id="@+id/white_noise_sound_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_graphic_eq"
                app:iconPadding="8dp"
                android:text="@string/white_noise_sound_label" />

            <Button
                android:id="@+id/white_noise_play_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconPadding="8dp"
                android:text="@string/white_noise_play_button" />

            <Button
                android:id="@+id/home_assistant_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_home"
                app:iconPadding="8dp"
                android:text="@string/home_assistant_button" />

            <TextView
                android:id="@+id/home_assistant_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textSize="13sp" />

            <Button
                android:id="@+id/grant_hc_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_favorite"
                app:iconPadding="8dp"
                android:text="@string/grant_hc_button" />

            <TextView
                android:id="@+id/hc_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center" />

            <Button
                android:id="@+id/widget_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_widgets"
                app:iconPadding="8dp"
                android:text="@string/add_widget_button" />

            <Button
                android:id="@+id/install_watch_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_watch"
                app:iconPadding="8dp"
                android:text="@string/install_watch_button" />

            <Button
                android:id="@+id/update_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minWidth="220dp"
                app:icon="@drawable/ic_system_update"
                app:iconPadding="8dp"
                android:text="@string/check_update_button" />

            <TextView
                android:id="@+id/update_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center" />

        </LinearLayout>

        <TextView
            android:id="@+id/version_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:alpha="0.6"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
